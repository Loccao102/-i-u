# Public map style URL only. Never put database secrets in NEXT_PUBLIC_*.
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json

# Server-only Supabase credentials.
# Project Settings -> API.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Optional. Free Open-Meteo endpoint is used when absent (personal/non-commercial use).
# For commercial use, configure a paid Open-Meteo key; the server switches to customer-api.
# OPEN_METEO_API_KEY=replace_me

# Optional. Server-only Google Places API (New) key for live place photos/details.
# Do NOT expose this as NEXT_PUBLIC_*.
# GOOGLE_PLACES_API_KEY=replace_me

# Optional. Override the public OpenStreetMap Overpass fallback for production.
# OVERPASS_API_URL=https://your-overpass-instance.example/api/interpreter
